{
  "name": "angelblanco-web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "cleanup": "turbo run cleanup",
    "prepare": "husky",
    "preview": "pnpm build && npx serve apps/angelblanco.dev/.output/public",
    "fresh": "bash ./fresh.sh",
    "ai:flash": "gemini -m gemini-2.5-flash",
    "ai:commit": "pnpm ai:flash --prompt-interactive \"/git:commit\""
  },
  "devDependencies": {
    "@angelblanco/eslint-config": "^2.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "turbo": "^2.11.10"
  }
}
