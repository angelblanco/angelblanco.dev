{
  "name": "@angelblanco/web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:storybook": "storybook build --quiet",
    "dev": "nuxt dev",
    "storybook": "sh .storybook/dev.sh",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p .nuxt/tsconfig.node.json",
    "postinstall": "nuxt prepare",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "cleanup": "nuxi cleanup",
    "automd": "automd"
  },
  "dependencies": {
    "@angelblanco/tailwind": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify-json/tabler": "^1.2.43",
    "@iconify-json/vscode-icons": "^1.2.95",
    "@nuxt/content": "^3.16.2",
    "@nuxt/image": "^2.2.1",
    "@orama/orama": "^3.1.18",
    "@tailwindcss/vite": "^4.3.4",
    "clsx": "^2.1.1",
    "feed": "6.0.0",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angelblanco/tsconfig": "workspace:*",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "2.6.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/color-mode": "4.0.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "6.0.1",
    "@storybook-vue/nuxt": "10.0.3",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@takumi-rs/core": "^2.19.0",
    "@unhead/vue": "^3.4.3",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "automd": "^0.4.3",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.4",
    "storybook": "10.6.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
